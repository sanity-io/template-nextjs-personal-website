{
  "name": "sanity-template-template-nextjs-personal-website",
  "private": true,
  "scripts": {
    "analyze": "next experimental-analyze --serve",
    "prebuild": "npm run stega-warn",
    "build": "next build --turbopack && sanity manifest extract --path public/studio/static",
    "predev": "npm run typegen && npm run stega-warn",
    "dev": "next --turbopack",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "npm run format && npm run lint -- --fix",
    "start": "next start",
    "stega-warn": "echo 'This template is using stega to embed Content Source Maps, see more information here: https://www.sanity.io/docs/loaders-and-overlays#26cf681fadd4'",
    "type-check": "next typegen && tsc --noEmit",
    "typegen": "sanity schema extract --force && sanity typegen generate"
  },
  "dependencies": {
    "@next/env": "16.3.0",
    "@sanity/client": "7.26.2",
    "@sanity/demo": "2.0.0",
    "@sanity/icons": "5.2.1",
    "@sanity/image-url": "2.1.1",
    "@sanity/ui": "3.5.3",
    "@sanity/util": "6.9.2",
    "@sanity/vision": "6.9.2",
    "@tailwindcss/typography": "0.5.20",
    "@vercel/speed-insights": "2.0.0",
    "classnames": "2.5.1",
    "date-fns": "4.4.0",
    "next": "16.3.0",
    "next-sanity": "13.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-live-transitions": "0.2.0",
    "rxjs": "7.8.2",
    "sanity": "6.9.2",
    "sanity-plugin-asset-source-unsplash": "7.0.23",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "styled-components": "6.5.2"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "autoprefixer": "10.5.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-formatter-gha": "2.0.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "oxfmt": "0.63.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "^7.0.2"
  }
}
