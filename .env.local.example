# Defaults, used by ./intro-template and can be deleted if the component is removed
NEXT_PUBLIC_VERCEL_GIT_REPO_OWNER="sanity-io"
NEXT_PUBLIC_VERCEL_GIT_PROVIDER="github"
NEXT_PUBLIC_VERCEL_GIT_REPO_SLUG="template-nextjs-personal-website"

# Required, find them on https://manage.sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# With the Sanity Vercel Marketplace integration, the app mints short-lived Sanity tokens through
# Vercel OIDC and needs no read token (`npx vercel env pull` provides VERCEL_OIDC_TOKEN locally).
# Otherwise, or as a fallback when minting fails, set a Viewer token from https://manage.sanity.io
SANITY_API_READ_TOKEN=
# Optional, useful if you plan to add API functions that can write to your dataset
SANITY_API_WRITE_TOKEN=

# Optional, shared with the Sanity Function in ./functions/invalidate-sync-tags so it can call
# /api/revalidate. Generate one with `openssl rand -hex 32`. See "Sanity Functions" in the README.
SANITY_REVALIDATE_SECRET=
# Optional, only read by `sanity blueprints deploy` (and `sanity functions test`) to configure that
# function with the deployed site's URL, e.g. https://your-site.vercel.app/api/revalidate
REVALIDATE_URL=
# Optional, set to "true" once that function is deployed to hold live events back until the cache
# has been invalidated (<SanityLive waitFor="function">). Leave unset for local development.
SANITY_LIVE_WAIT_FOR_FUNCTION=

# Optional, can be used to change the Studio title in the navbar and differentiate between production and staging environments for your editors
NEXT_PUBLIC_SANITY_PROJECT_TITLE="Next.js Personal Website with Sanity.io"
